# Copy this file to .env and replace every value before starting the lab.
# .env is ignored by Git and must never be committed.
JWT_SECRET=replace-with-at-least-32-random-characters
MYSQL_ROOT_PASSWORD=replace-with-a-local-lab-password
AUTH_DB_PASSWORD=replace-with-a-local-lab-password
LOG_DB_PASSWORD=replace-with-a-local-lab-password
CA_READER_PASSWORD=replace-with-a-local-lab-password
REVOKER_PASSWORD=replace-with-a-local-lab-password
LAB_ROOT_PASSWORD=replace-with-a-local-lab-password
LAB_SSH_PASSWORD=replace-with-a-local-lab-password
