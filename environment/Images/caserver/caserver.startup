#!/bin/bash
set -euo pipefail

echo ""
echo "CA-server startup..."

# Assign IP address to eth0
ip addr add 10.101.0.2/24 dev eth0

# Bring eth0 up
ip link set eth0 up

# Add default route
ip route add default via 10.101.0.1

# Update /etc/hosts (lab simulation)
{
  echo "10.99.0.1 client"
  echo "10.100.0.253 fw1"
  echo "10.100.0.1 webserver"
  echo "10.101.0.254 fw2"
  echo "10.101.0.1 authserver"
  echo "10.101.0.3 logserver"
} >> /etc/hosts

# Set up basic local firewall rules (lab)
iptables -P INPUT DROP
iptables -P FORWARD DROP
iptables -A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

iptables -A INPUT -i lo -j ACCEPT

# Allow SSH, HTTPS from authserver only (adjust IPs to your topology)
iptables -A INPUT -p tcp -s 10.101.0.1 -m multiport --dports 22,443 -m conntrack --ctstate NEW -j ACCEPT
iptables -A INPUT -p icmp -j ACCEPT

# Allow outgoing HTTPS to logserver (caserver -> logserver for logs)
iptables -A OUTPUT -p tcp -d 10.101.0.3 --dport 443 -m conntrack --ctstate NEW -j ACCEPT

echo "caserver startup configured"
