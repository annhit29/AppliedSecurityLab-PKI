#!/bin/bash

# Send configs
send_config() {
  local FILE="$1"

  if [[ -f "$FILE" ]]; then
    local B64
    B64=$(base64 -w0 "$FILE")

    curl -X POST "https://logserver/archive/config" \
      --cert /etc/ssl/nginx/nginx.crt \
      --key  /etc/ssl/nginx/nginx.key \
      --cacert /etc/ssl/ca/certs/ca.cert.pem \
      -H "Content-Type: application/json" \
      -d "{
            \"file_path\": \"${FILE}\",
            \"content\": \"${B64}\"
          }"  > /dev/null
  fi
}

send_config "/etc/ssl/ca/openssl.cnf" 
send_config "/etc/nginx/sites-available/caserver"

# Start SSH
echo "Starting SSH service..."
service ssh start

# Start nginx (outward facing) server
echo "Starting nginx - serving HTTPS/mTLS..."
nginx -g "daemon off;" &

# Start Flask CA API (gunicorn) on localhost
echo "Starting Flask CA API (gunicorn) on 127.0.0.1:5000..."
gunicorn -w 2 -b 127.0.0.1:5000 ca_api:app &

echo "caserver startserver configured"
