#!/bin/bash

# Set permissions
chmod 400 /etc/ssl/webserver/webserver.key
chmod 444 /etc/ssl/webserver/webserver.crt
chmod 444 /etc/ssl/webserver/ca.cert.pem

# Send configs
send_config() {
  local FILE="$1"

  if [[ -f "$FILE" ]]; then
    local B64
    B64=$(base64 -w0 "$FILE")

    curl -s -X POST "https://logserver/archive/config" \
      --cert /etc/ssl/webserver/webserver.crt \
      --key  /etc/ssl/webserver/webserver.key \
      --cacert /etc/ssl/webserver/ca.cert.pem \
      -H "Content-Type: application/json" \
      -d "{
            \"file_path\": \"${FILE}\",
            \"content\": \"${B64}\"
          }" > /dev/null
  fi
}

send_config "/etc/nginx/sites-available/webserver"

# Start SSH server
echo "Starting SSH..."
service ssh start

# Start nginx
echo "Starting nginx..."
nginx -g "daemon off;" &

echo "Generate secret key for Flask App..."
python3 -c 'import secrets; print(secrets.token_hex())' > flask_sk

# Start Flask with gunicorn
echo "Starting Flask app..."
gunicorn -w 2 -b 127.0.0.1:5000 webserver:app &

echo "webserver startserver configured"
